# Copy to .env and adjust. Never commit .env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=devpass
POSTGRES_DB=olist

# Host port mapped to the container's 5432.
# Changed from the default 5432 because another local project already uses it.
HOST_PORT=5433

# Cohere trial key, used only by scripts/embed_reviews.py for the Phase 5.5
# sample. Free at dashboard.cohere.com -> API Keys. Not needed to stand the
# database up; everything else works without it.
COHERE_API_KEY=
